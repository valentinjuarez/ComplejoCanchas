generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique
  role  Role   @default(USER)

  // Si ya migraste a AdminUser, yo dejaría esto SOLO si lo usás.
  // Si no lo usás más: lo sacamos luego.
  passwordHash String?

  reservations Reserva[]
  createdAt    DateTime  @default(now())
}

model Cancha {
  id           Int       @id @default(autoincrement())
  name         String
  type         String
  active       Boolean   @default(true)
  reservations Reserva[]
}

model Reserva {
  id        Int      @id @default(autoincrement())
  date      DateTime
  startTime DateTime
  endTime   DateTime

  // Precio final (si pagó)
  price Float

  // ✅ ahora soporta flujo de pago / hold
  status ReservationStatus @default(ACTIVE)

  // ✅ “hold” vence si no paga
  expiresAt DateTime?

  // ✅ token para cancelación por mail
  cancelToken String?   @unique
  canceledAt  DateTime?
  refunded    Boolean   @default(false)

  userId  Int
  courtId Int

  user  Usuario @relation(fields: [userId], references: [id])
  court Cancha  @relation(fields: [courtId], references: [id])

  // ✅ pagos asociados (0 o muchos)
  payments Payment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([status])
  @@index([courtId])
  @@index([startTime])
  @@index([expiresAt])
}

enum ReservationStatus {
  ACTIVE
  CANCELED

  // ✅ Para MP:
  PENDING_PAYMENT // se creó, está esperando pago
  EXPIRED // venció el hold / pago no confirmado
}

enum PaymentProvider {
  MERCADOPAGO
}

enum PaymentStatus {
  CREATED // generaste preferencia
  PENDING // el usuario está pagando
  APPROVED // pagado ok
  REJECTED // rechazado
  CANCELLED // cancelado por usuario
  REFUNDED // devuelto
  CHARGEDBACK // contracargo (opcional)
}

model Payment {
  id Int @id @default(autoincrement())

  provider PaymentProvider @default(MERCADOPAGO)
  status   PaymentStatus   @default(CREATED)

  // total/importe del pago (seña)
  amount   Float
  currency String @default("ARS")

  // IDs MercadoPago (opcionales hasta que se completen)
  mpPreferenceId    String? @unique
  mpPaymentId       String? @unique
  mpMerchantOrderId String?

  // Metadatos y trazabilidad
  rawWebhook Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relación
  reservationId Int
  reservation   Reserva @relation(fields: [reservationId], references: [id])

  @@index([reservationId])
  @@index([status])
}

enum AdminRole {
  ADMIN
  STAFF
}

model AdminUser {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum Role {
  USER
  ADMIN
}
